/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neutra",
  "account_id": "9e1f03747e81e14938c2d2f78d9ac40d",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],
  // The URL MCP clients connect to. neutra.day is attached to this Worker as a Custom Domain
  // in the Cloudflare dashboard (Workers & Pages → neutra → Settings → Domains & Routes).
  "vars": {
    "MCP_RESOURCE": "https://neutra.day/mcp",
    // "allowlist": only the emails in ALLOWED_EMAILS can sign in. "open": any verified Google account.
    "ACCESS_MODE": "open",
    // Price decisions. "off": the tool isn't offered and price answers are refused. "testers": only
    // ALLOWED_EMAILS can start one (anyone with the code can answer). "open": everyone. See docs/RUNBOOK.md.
    "PRICE_DECISIONS": "off",
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "0cfbaff957444146814c3e0ce445b7cb"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "neutra",
      "database_id": "7a13cdd1-b529-4bf7-86e8-68e10370f532",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 8788
  }
}
