/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neutra",
  "account_id": "9e1f03747e81e14938c2d2f78d9ac40d",
  "main": "src/index.ts",
  "compatibility_date": "2025-03-10",
  "compatibility_flags": ["nodejs_compat"],
  // The URL MCP clients connect to. Set it to your deployed URL, for example
  // https://<worker-name>.<your-subdomain>.workers.dev/mcp
  "vars": {
    "MCP_RESOURCE": "https://neutra.neutra-dev.workers.dev/mcp",
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "0cfbaff957444146814c3e0ce445b7cb"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "neutra",
      "database_id": "7a13cdd1-b529-4bf7-86e8-68e10370f532",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 8788
  }
}
